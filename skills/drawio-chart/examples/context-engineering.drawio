          <mxGeometry height="110" width="170" x="140" y="340" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E99151;strokeColor=#E99151;strokeWidth=1.5;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=10;shadow=1;fontStyle=1;" value="中优先级&lt;br/&gt;RAG 背景资料&lt;br/&gt;工具 Observation&lt;br/&gt;二次裁剪，保留关键段落" vertex="1">
          <mxGeometry height="100" width="190" x="504" y="360" as="geometry" />
        </mxCell>
